# ms-cafeterias — variables de entorno
# Copiar a .env y completar. El .env NO se versiona.

# URL de Supabase.
# Local (Supabase CLI en Docker, desde otro contenedor):
SUPABASE_URL=http://host.docker.internal:54321
# Local, si el proceso corre en el host de Windows:
# SUPABASE_URL=http://127.0.0.1:54321

# Clave de SERVIDOR (service_role) de la instancia local de Supabase.
# Se obtiene de `supabase status` -> "service_role key". NO es la clave
# publishable/anon de las apps: esa es rol anon y la RLS la limita.
# Ver services/README.md.
SUPABASE_SERVICE_KEY=pon-aqui-la-service-role-key-local

# Puerto del servicio. El gateway lo descubre por DNS interno, no lo cambia.
PORT=3002

# Entorno: development | production
NODE_ENV=development