# Entorno local de los microservicios de CoffeeFast.
#
# Uso:  docker compose up --build
#       (docker compose lee este .env automaticamente, es el archivo sibling)
#
# NO se sube al repositorio: esta en .gitignore. Para crearlo desde cero:
#   cp .env.example .env    y poner la service_role key local real.
#
# Las URLs usan `host.docker.internal` porque este compose corre los servicios en
# contenedores Docker, pero Supabase corre en el HOST. Dentro de un contenedor,
# `localhost` es el propio contenedor, no el host.

SUPABASE_URL=http://host.docker.internal:54321

# Clave de SERVIDOR (service_role) de Supabase. Se obtiene de:
#   supabase status   ->   "service_role key"
# NO es la publishable/anon que usan las apps: esa es rol anon y la RLS la
# limita. Ver services/README.md para por que los services no dependen de RLS.
SUPABASE_SERVICE_KEY=cambiar-por-la-service-role-key-local

# Puerto en el host del gateway (el unico que las apps deben usar).
GATEWAY_PORT=8080

# Puertos en el host de cada servicio. Expuestos solo para depurar el servicio
# directo; el camino normal de las apps es por el gateway.
MS_CAFETERIAS_PORT=3002
MS_MENUS_PORT=3003
MS_INVENTARIO_PORT=3004
MS_PEDIDOS_PORT=3005