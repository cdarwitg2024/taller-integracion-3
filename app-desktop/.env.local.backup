# =============================================================================
# CoffeeFaster - App Escritorio (Vite) - variables de entorno
# =============================================================================
# Vite solo lee este archivo desde la raiz del PAQUETE (app-desktop/).
# El .env de la raiz del monorepo lo usan el backend y las apps, NO el desktop.
# Reinicia `npm run dev` despues de cualquier cambio.
#
# Este archivo esta en .gitignore: NO se sube al repositorio.
# =============================================================================

# --- Supabase (BD local via Docker) -----------------------------------------
# URL local de la instancia de Supabase.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Clave PUBLICABLE (publishable / anon). NUNCA la service_role: esa se salta el RLS.
# Es la misma clave publica definida en el .env de la raiz del monorepo.
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# --- Backend Node (opcional) ------------------------------------------------
# URL del backend-node en desarrollo.
VITE_BACKEND=http://localhost:3000

# Id de la cafeteria que usa el cliente (la cafeteria "Café Central" del seed).
VITE_CAFETERIA_ID=1

# --- Credenciales de las pantallas de login ---------------------------------
# El login intenta primero contra la BD real con estas credenciales;
# el fallback de desarrollo (usuarios.js) solo se activa con import.meta.env.DEV.
VITE_DEV_ADMIN_EMAIL=dueno@coffeefaster.cl
VITE_DEV_ADMIN_PASSWORD=123456
VITE_DEV_EMPLEADO_EMAIL=empleado@coffeefaster.cl
VITE_DEV_EMPLEADO_PASSWORD=123456
