# =============================================================================
# CoffeeFaster - App Escritorio (Vite) - ejemplo de variables para PRODUCCION
# =============================================================================
# Archivo SOLO demostrativo: no contiene valores reales. Al construir por
# Docker estas variables se pasan como --build-arg (ver app-desktop/Dockerfile)
# y quedan embebidas en el bundle JS. Las claves NUNCA van en este archivo.
#
# URL de la Supabase CLOUD que usa el cluster (ver Secret coffeesecret-supabase)
VITE_SUPABASE_URL=https://yvkpmqcynpygqjvaoiwn.supabase.co
# Clave PUBLICABLE (anon) de ESA MISMA cloud. En el build:
#   --build-arg VITE_SUPABASE_PUBLISHABLE_KEY=<la publishable de la cloud>
# Nunca la service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Backend publico del cluster (gateway de microservicios)
VITE_BACKEND=https://api-cdarwitg.dev.censei.cl
# Id de la cafeteria por defecto (en la cloud: 1 = "Café Central")
VITE_CAFETERIA_ID=1