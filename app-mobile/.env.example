# =============================================================================
# CoffeeFast — App Movil · variables de entorno
# =============================================================================
# Copia este archivo como `.env` y completa los valores:
#     cp .env.example .env      (Windows: copy .env.example .env)
#
# IMPORTANTE
#   - Expo solo expone las variables que empiezan con `EXPO_PUBLIC_`.
#   - El archivo `.env` esta en .gitignore: NO se sube al repositorio.
#   - `VITE_` NO funciona aqui, ese prefijo es de Vite (app-desktop).
# =============================================================================

# URL del proyecto Supabase  ->  Supabase Dashboard > Settings > Data API
EXPO_PUBLIC_SUPABASE_URL=https://yrswjmxdpmiyfpclrfmg.supabase.co

# Clave publicable (publishable / anon)
#   -> Supabase Dashboard > Settings > Data API > Project API keys
#   -> "publishable" o "anon". NUNCA la service_role (esa se salta el RLS).
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_CTXjURN8DxkNYj0ULlUUYQ_M6yH3P4B

# URL del backend Node (opcional)
#   - En emulador de Android usa 10.0.2.2 en vez de localhost
#   - Se deja vacio si la app todavia no llama al backend
EXPO_PUBLIC_API_URL=
