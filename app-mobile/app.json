{
  "name": "CoffeeFastApp",
  "displayName": "CoffeeFast",
  "scheme": "coffeefast",
  "icon": "./assets/icon.png",
  "userInterfaceStyle": "light",
  "splash": {
    "image": "./assets/splash-icon.png",
    "resizeMode": "contain",
    "backgroundColor": "#F8ECDA"
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#F8ECDA"
    }
  },
  "ios": {
    "supportsTablet": true
  },
  "web": {
    "favicon": "./assets/icon.png"
  },
  "plugins": [
    "expo-asset"
  ]
}
