# ms-cafeterias — plantilla de variables para desarrollo local.
#
# NO es un manifiesto de Kubernetes. K8s toma estos valores del Secret
# `coffeesecret-supabase`, que se crea a mano y nunca se versiona:
#
#   kubectl create secret generic coffeesecret-supabase \
#     --from-literal=SUPABASE_URL=http://host.docker.internal:54321 \
#     --from-literal=SUPABASE_SERVICE_KEY=<service-role-key-local> \
#     -n student-cdarwitg
#
# La key del Secret es SUPABASE_SERVICE_KEY = clave de servidor del proyecto.
#
# Para leerlo desde un Pod:
#   kubectl exec deploy/ms-cafeterias -n student-cdarwitg -- printenv SUPABASE_URL
#
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_KEY=pon-aqui-la-service-role-key-local
PORT=3002
NODE_ENV=development