# Plantilla local; Kubernetes usa secretKeyRef a coffeesecret-supabase.
# Requiere las tres claves siguientes; no se verifico el Secret remoto.
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=pon-aqui-la-service-role-key-local
SUPABASE_PUBLISHABLE_KEY=pon-aqui-la-publishable-key-local
PORT=3005
NODE_ENV=development
